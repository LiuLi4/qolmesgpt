{
  "name": "@qolmesgpt/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --experimental-strip-types --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@alicloud/log": "1.2.6",
    "@gitbeaker/rest": "43.8.0",
    "@prisma/client": "^7.10.1",
    "@qolmesgpt/contracts": "workspace:*",
    "@qolmesgpt/security": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
